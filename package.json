{
  "name": "@tuffite/www",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run generate && astro dev --host 127.0.0.1 --port 5190",
    "generate": "bun run icons && bun run scripts/generate-reference.ts",
    "build": "bun run generate && bun run docs:rust && astro check && astro build && bun run scripts/prepare-deployment.ts --record",
    "preview": "astro preview --host 127.0.0.1 --port 5190",
    "check": "bun run format:check && bun run generate && astro check",
    "docs:rust": "bun run scripts/generate-rustdoc.ts",
    "icons": "bun run scripts/generate-icons.ts",
    "deploy:prepare": "bun run check && bun run build",
    "deploy": "bun run scripts/prepare-deployment.ts && wrangler pages deploy dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@astrojs/starlight": "0.40.0",
    "astro": "6.4.8",
    "i18next": "26.5.8",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@astrojs/check": "0.9.12",
    "prettier-plugin-astro": "1.1.2",
    "wrangler": "4.152.0"
  }
}
