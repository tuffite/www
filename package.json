{
  "name": "@tuffite/www",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run generate && vite --host 127.0.0.1 --port 5190",
    "generate": "bun run icons && bun run scripts/generate-reference.ts",
    "build": "bun run generate && bun run docs:rust && tsc --noEmit && vite build && bun run scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5190",
    "check": "bun run format:check && bun run generate && tsc --noEmit && bun test",
    "docs:rust": "bun run scripts/generate-rustdoc.ts",
    "icons": "bun run scripts/generate-icons.ts",
    "release:prepare": "bun run check && bun run build && bun run scripts/prepare-release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "1.63.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
